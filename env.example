DBASE_NAME=
DBASE_USER=
DBASE_PASSWORD=
DBASE_HOST=
DBASE_PORT=5432
DBASE_DRIVER=postgresql

DATABASE_URL=
DATABASE_ECHO=false
DATABASE_POOL_PRE_PING=true
WEBAPP_REPORT_CLEANUP_GRACE_HOURS=0
WEBAPP_REPORT_METRICS_TTL_MINUTES=15
SCHEDULE_WEBAPP_REPORT_CLEANUP_CRON=*/15 * * * *
SCHEDULE_WEBAPP_REPORT_CLEANUP_TZ=UTC
SCHEDULE_WEBAPP_REPORT_CLEANUP_ENABLED=true

SCHEDULE_TOKENS_CRON=0 */6 * * *
SCHEDULE_TOKENS_TZ=UTC
SCHEDULE_TOKENS_ENABLED=true

SCHEDULE_SUBSCRIBES_CRON=0 4 * * *
SCHEDULE_SUBSCRIBES_TZ=UTC
SCHEDULE_SUBSCRIBES_ENABLED=true

SCHEDULE_FRANCHISEE_CRON=0 5 * * *
SCHEDULE_FRANCHISEE_TZ=UTC
SCHEDULE_FRANCHISEE_ENABLED=true

DODO_API_TIMEOUT_SECONDS=30
DODO_API_RETRY_LIMIT=5
DODO_API_RETRY_DELAY_SECONDS=60
DODO_API_USER_AGENT=DodoVkus
DODO_API_TRUST_ENV=true

# Dodovkus token encryption/decryption endpoints
DODOVKUS_TOKEN_AUTH_DEFAULT_SERVICE_KEY=
DODOVKUS_TOKEN_DECRYPT_URL=https://dodovkus.ru/auth/decrypt-tokens/
DODOVKUS_TOKEN_UPDATE_URL=https://dodovkus.ru/auth/updated-tokens/
DODOVKUS_TOKEN_AUTH_TIMEOUT_SECONDS=30
DODOVKUS_TOKEN_AUTH_TRUST_ENV=true

# Dodo OAuth application secrets from Kubernetes Secret/env.
# Application name is special.applications.name uppercased.
DODO_APP_AIDA_SECRET=
DODO_APP_AIDA_VERIFIER=
DODO_APP_AIDAMETRICS_SECRET=
DODO_APP_AIDAMETRICS_VERIFIER=
DODO_APP_CORE_SECRET=
DODO_APP_CORE_VERIFIER=
DODO_APP_KADO_SECRET=
DODO_APP_KADO_VERIFIER=

RABBIT_URL=amqp://guest:guest@localhost:5672/
RABBIT_QUEUE=aida
RABBIT_QUEUE_MAX=aida-max
RABBIT_EXCHANGE=
RABBIT_ROUTING_KEY=
RABBIT_EXCHANGE_TYPE=direct
RABBIT_DURABLE=true
RABBIT_ENABLED=true
